{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.claude",
      "!!**/.codex",
      "!!**/node_modules",
      "!!**/dist",
      "!!spikes",
      "!!.superpowers",
      "!!.pnpm-store",
      "!!scripts",
      "!!pnpm-lock.yaml",
      "!!apps/emend/drizzle",
      "!!apps/emend/src/db/migrations.gen.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
