# Commands Codex never runs in emend. Codex writes code. The main session and the owner commit,
# push, merge, install and deploy. The sandbox has no network, so these rules are a second layer.
# Decisions: allow, prompt, forbidden.

prefix_rule(
    pattern = ["git", ["push", "commit", "merge", "rebase", "reset", "tag", "stash", "clean", "filter-branch", "filter-repo"]],
    decision = "forbidden",
    justification = "Leave changes in the working tree. Commits, pushes and history changes belong to the main session and the owner.",
    match = ["git push origin main", "git commit -m x", "git reset --hard"],
    not_match = ["git status", "git diff --stat"],
)

prefix_rule(
    pattern = [["wrangler", "node_modules/.bin/wrangler"]],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
    match = ["wrangler deploy", "wrangler d1 execute DB --remote"],
)

prefix_rule(
    pattern = [["npx", "pnpx", "bunx"], "wrangler"],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
)

prefix_rule(
    pattern = ["pnpm", ["exec", "dlx"], "wrangler"],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
)

prefix_rule(
    pattern = ["pnpm", "wrangler"],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
)

prefix_rule(
    pattern = [["drizzle-kit", "node_modules/.bin/drizzle-kit"], ["push", "migrate"]],
    decision = "forbidden",
    justification = "Generate migrations with pnpm db:generate. emend applies them itself when it opens its database.",
)

prefix_rule(
    pattern = [["npx", "pnpx", "bunx"], "drizzle-kit", ["push", "migrate"]],
    decision = "forbidden",
    justification = "Generate migrations with pnpm db:generate. emend applies them itself when it opens its database.",
)

prefix_rule(
    pattern = ["pnpm", ["exec", "dlx"], "drizzle-kit", ["push", "migrate"]],
    decision = "forbidden",
    justification = "Generate migrations with pnpm db:generate. emend applies them itself when it opens its database.",
)

prefix_rule(
    pattern = ["pnpm", ["deploy", "publish"]],
    decision = "forbidden",
    justification = "Publishing emend is the owner's step.",
)

prefix_rule(
    pattern = [["pnpm", "npm"], ["run", "run-script"], "deploy"],
    decision = "forbidden",
    justification = "Publishing emend is the owner's step.",
)

prefix_rule(
    pattern = ["pnpm", ["add", "install", "i", "update", "up", "remove", "rm", "link"]],
    decision = "forbidden",
    justification = "The owner approves each dependency, and the main session installs it. Ask the main session.",
)

prefix_rule(
    pattern = ["npm", ["install", "i", "ci", "update", "uninstall", "publish"]],
    decision = "forbidden",
    justification = "emend uses pnpm, and the main session installs dependencies after the owner approves them.",
)

prefix_rule(
    pattern = ["gh"],
    decision = "forbidden",
    justification = "GitHub actions belong to the main session and the owner.",
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Nothing in emend needs root.",
)

prefix_rule(
    pattern = ["git", ["-C", "-c", "--git-dir", "--work-tree", "--no-pager", "-p", "--paginate", "--no-optional-locks", "--config-env", "--exec-path", "-P"]],
    decision = "forbidden",
    justification = "A git global option can change the repository, config or pager that git runs. Run plain git commands from the repository root.",
)

prefix_rule(
    pattern = ["git", ["cherry-pick", "revert", "am", "commit-tree", "update-ref", "notes", "config", "ci", "switch"]],
    decision = "forbidden",
    justification = "These change history, refs, config or the branch. Codex never needs to change branches. Leave changes in the working tree.",
)

prefix_rule(
    pattern = [["npx", "pnpx", "bunx", "yarn", "bun", "corepack"]],
    decision = "forbidden",
    justification = "These fetch and run packages. The main session runs tools after the owner approves them.",
)

prefix_rule(
    pattern = ["pnpm", "dlx"],
    decision = "forbidden",
    justification = "pnpm dlx fetches and runs a package. The owner approves each dependency.",
)

prefix_rule(
    pattern = ["pnpm", ["-C", "--dir", "--filter", "-F", "-w", "--workspace-root", "-r", "--recursive", "-s", "--silent"]],
    decision = "forbidden",
    justification = "A pnpm global flag changes which package or workspace a command runs in. Run pnpm commands from the repository root.",
)

prefix_rule(
    pattern = ["npm", ["add", "in", "ins", "inst", "insta", "instal", "isnt", "isnta", "isntal", "isntall", "up", "upgrade", "remove", "rm", "r", "un", "unlink", "link", "x", "exec", "run-script"]],
    decision = "forbidden",
    justification = "emend uses pnpm, and the main session installs dependencies after the owner approves them.",
)

prefix_rule(
    pattern = ["./node_modules/.bin/wrangler"],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
)

prefix_rule(
    pattern = ["node", ["node_modules/wrangler/bin/wrangler.js", "./node_modules/wrangler/bin/wrangler.js"]],
    decision = "forbidden",
    justification = "emend does not use wrangler. Deploying and remote setup are the owner's step.",
)
