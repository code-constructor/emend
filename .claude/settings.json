{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(~/.local/share/emend/**)",
      "Read(~/Library/Application Support/emend/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.docker/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.kube/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.config/op/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-subagent-model.sh\" || exit 2",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
